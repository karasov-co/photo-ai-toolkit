# xAI, which is what this toolkit runs on by default (grok-4.6).
XAI_API_KEY=your_xai_api_key_here

# OPENAI_API_KEY is also picked up, and is used when XAI_API_KEY is absent --
# so an existing OpenAI key keeps working without being renamed. Where both
# are set, XAI_API_KEY wins: writing it says which service you meant.
OPENAI_API_KEY=

# Optional. Overrides the default model and provider.
# OPENAI_MODEL=grok-4.6
# PHOTO_AI_PROVIDER=grok
