{
  "schema_version": 1,
  "ruleset_version": "2026.08.11",
  "disclaimer": "Marketplace policies change without notice. Every rule below carries the source it came from and the date it was last checked. Re-verify before relying on any of it for a submission. Nothing here is a guarantee of acceptance or of sales.",
  "platforms": [
    {
      "id": "adobe_stock",
      "name": "Adobe Stock",
      "accepts": ["photo", "video"],
      "verified_on": "2026-08-11",
      "sources": [
        "https://helpx.adobe.com/stock/contributor/submit-your-content/submit-photos/technical-legal-requirements-photo-submission.html",
        "https://helpx.adobe.com/stock/contributor/submit-your-content/submit-videos/technical-requirements-for-video-submissions.html"
      ],
      "photo": {
        "min_megapixels": 4.0,
        "max_megapixels": 100.0,
        "formats": ["JPEG"],
        "color_profile": "sRGB",
        "max_file_size_mb": 45,
        "notes": "12 MP or more is the practical norm even though 4 MP is the floor."
      },
      "video": {
        "min_duration_s": 5.0,
        "max_duration_s": 60.0,
        "recommended_duration_s": [10.0, 20.0],
        "min_width": 1920,
        "min_height": 1080,
        "max_width": 4096,
        "containers": ["mov", "mp4", "mpeg"],
        "notes": "Submit at native capture resolution. Up-ressing HD to 4K is a rejection reason."
      },
      "generative_ai": "accepted_with_label",
      "generative_ai_note": "Generative content is accepted when correctly declared as such at submission.",
      "requires_model_release": true,
      "requires_property_release": true,
      "editorial_accepted": true,
      "max_keywords": 49,
      "keyword_note": "The first ten keywords carry the most weight; order them deliberately.",
      "manual_submission_required": false
    },
    {
      "id": "shutterstock",
      "name": "Shutterstock",
      "accepts": ["photo", "video"],
      "verified_on": "2026-08-11",
      "sources": [
        "https://submit.shutterstock.com/help/en/articles/10594622-content-policy-updates-ai-generated-content",
        "https://submit.shutterstock.com/help/en/articles/10594676-ai-generated-content-on-shutterstock-contributor-faq"
      ],
      "photo": {
        "min_megapixels": 4.0,
        "formats": ["JPEG"],
        "color_profile": "sRGB"
      },
      "video": {
        "min_duration_s": 5.0,
        "max_duration_s": 60.0,
        "min_width": 1920,
        "min_height": 1080,
        "containers": ["mov", "mp4"]
      },
      "generative_ai": "rejected",
      "generative_ai_note": "Contributor-submitted AI-generated content from external tools is not accepted. Metadata is scanned automatically for C2PA credentials, IPTC DigitalSourceType and XMP/EXIF signatures from known generators; an undeclared match is auto-rejected and can carry an account strike.",
      "requires_model_release": true,
      "requires_property_release": true,
      "editorial_accepted": true,
      "max_keywords": 50,
      "manual_submission_required": false
    },
    {
      "id": "getty_istock",
      "name": "Getty Images / iStock",
      "accepts": ["photo", "video"],
      "verified_on": "2026-08-11",
      "sources": ["https://contributors.gettyimages.com/article/10847"],
      "photo": {
        "min_megapixels": 4.0,
        "formats": ["JPEG"],
        "color_profile": "sRGB"
      },
      "video": {
        "min_duration_s": 5.0,
        "max_duration_s": 60.0,
        "min_width": 1920,
        "min_height": 1080,
        "containers": ["mov", "mp4"]
      },
      "generative_ai": "rejected",
      "generative_ai_note": "Retouching and modification are governed by an explicit policy; generative alteration of documentary content is not permitted.",
      "requires_model_release": true,
      "requires_property_release": true,
      "editorial_accepted": true,
      "exclusive_by_default": true,
      "max_keywords": 50,
      "manual_submission_required": true,
      "manual_note": "Contribution is by invitation and is reviewed per collection; there is no open contributor API."
    },
    {
      "id": "alamy",
      "name": "Alamy",
      "accepts": ["photo", "video"],
      "verified_on": "2026-08-11",
      "sources": [
        "https://www.alamy.com/blog/capturing-the-real-alamys-commitment-to-championing-authentic-photography",
        "https://www.alamy.com/help/contributor-quality-control/"
      ],
      "photo": {
        "min_megapixels": 4.0,
        "formats": ["JPEG", "TIFF"],
        "color_profile": "sRGB"
      },
      "video": {
        "min_duration_s": 5.0,
        "max_duration_s": 120.0,
        "min_width": 1920,
        "min_height": 1080,
        "containers": ["mov", "mp4"]
      },
      "generative_ai": "rejected",
      "generative_ai_note": "AI-generated imagery is classified as unsuitable material and is removed on discovery; repeat breaches can terminate the contributor contract. AI tools that mimic conventional retouching -- denoise in particular -- remain acceptable on an original photograph. Generative Fill and anything that alters the reality of the original does not.",
      "requires_model_release": true,
      "requires_property_release": true,
      "editorial_accepted": true,
      "editorial_strength": "high",
      "max_keywords": 50,
      "manual_submission_required": false
    },
