# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Local photo libraries and run output. An output directory is a farm of
# symlinks into somebody's own photo library plus a cache -- meaningless to
# anyone else, and 544 of them were committed once.
# Anchored to the root. Unanchored, `photos/` also matched `demo/photos/`, so
# the twelve frames the demo runs on were silently never committed and every CI
# job failed on a directory that exists only on the author's machine.
/photos/
/results/
/run/
# Both spellings. The folder this project actually writes is `photo-results`,
# with a hyphen; the ignore said `photo_results` with an underscore, so 3,440
# files walked straight past it into the repository.
photo_results/
photo-results/
/test_results/
/stories_picks/
*.log

# Never versioned, wherever they turn up: the caches and derivatives a run
# generates. `report/assets/` alone is one JPEG per photograph, twice.
**/.internal/
**/report/assets/

# Large media that must never enter git history (GitHub rejects blobs >100 MB)
*.MOV
*.mov
*.RW2
*.ARW
*.CR3
*.NEF

# ...but the generated test fixtures are committed on purpose
!tests/fixtures/**

# OS noise
.DS_Store

# Coverage output
.coverage
coverage.xml
htmlcov/

# Packaging
photo_ai_toolkit.egg-info/
*.egg-info/
build/
dist/
